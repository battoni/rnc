# Test-mode environment — committed (the real .env is gitignored, so CI has none).
# Loaded by Vite for `--mode test` (the Playwright e2e dev server).
#
# IMPORTANT: only pin values that MATCH the local .env, so this file never changes
# local behavior — it only supplies CI, which has no .env. (Vitest's language is
# pinned separately in vitest.config.ts.)
#
# Retired (rnc-4 AM4): "Deliberately NO VITE_API_URL here: locally that would override
# the real backend in .env". The API is same-origin at `/api` everywhere now (D4) — the
# local .env says the same — so pinning it changes nothing locally, and the e2e suite's
# `**/api/**` intercepts match on every host instead of depending on whichever absolute
# URL a developer's .env happened to name.
VITE_API_URL=/api
VITE_ROOT_DOMAIN=localhost

# Specs target the username login flow (code default is 'phone') and English UI
# (code default is 'pt-BR'); these match the local .env.
VITE_LOGIN_FLOW=username
VITE_DEFAULT_LANGUAGE=en

# The neutral ground (rnc-4 D10), the same as the local .env. Retired: "the Franco theme — the
# contrast specs measure it": a firm's colours are painted from its `public/firm` row now, and the
# suite's default answer (e2e/fixtures/auth.ts) is Franco's, so the specs measure Franco's runtime palette.
VITE_ACTIVE_THEME=hub
