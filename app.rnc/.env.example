# URLs
# Same-origin (rnc-4 D4): Vite proxies `/api` to http://localhost:8000; each firm host keeps its
# own session cookie. VITE_ROOT_DOMAIN: `<slug>.<root>` is a firm, the root and www the platform.
VITE_API_URL=/api
VITE_ROOT_DOMAIN=localhost
VITE_APP_URL=http://localhost:5173

# Sentry
VITE_SENTRY=
VITE_SENTRY_PROPAGATION_TARGETS="['localhost', 'https://myappwithport.test:5173', 'https://myappwithoutport.test']"
VITE_SENTRY_AUTH_TOKEN=
SENTRY_AUTH_TOKEN=
VITE_SENTRY_PROJECT_NAME=project_name_that_will_be_on_sentry

# SSL — empty: plain http on localhost:5173. Valet projects name their cert here.
VITE_LOCAL_SSL_KEY=
VITE_LOCAL_SSL_CERT=

# Theme: active brand theme — must match a file in src/styles/theme/themes/<name>.css
VITE_ACTIVE_THEME=franco

# Language — the products this bootstrap serves are Brazilian. A product elsewhere sets `en` here.
VITE_DEFAULT_LANGUAGE=pt-BR

# The documentation portal. Unset: the navigation shows no documentation entry at all.
VITE_DOCS_URL=

# Auth: default login entry — `phone` (WhatsApp code), `password` (phone/email + password), or
# `username` (username + password; also what any other value falls back to). Unset means `phone`.
# The e-mail code (OTP) flow is not selectable here: it always lives at /login-email and /entrar-email.
VITE_LOGIN_FLOW=username

# Auth: every login flow posts to the real `auth/login`. There is no mock identifier left in code.
