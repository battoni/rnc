{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "components.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "@Composables": ["./src/composables"],
      "@Composables/*": ["./src/composables/*"],
      "@Assets": ["./src/assets"],
      "@Assets/*": ["./src/assets/*"],
      "@Constants": ["./src/constants"],
      "@Constants/*": ["./src/constants/*"],
      "@Directives": ["./src/directives"],
      "@Directives/*": ["./src/directives/*"],
      "@Enums": ["./src/enums"],
      "@Enums/*": ["./src/enums/*"],
      "@Helpers": ["./src/helpers"],
      "@Helpers/*": ["./src/helpers/*"],
      "@Interfaces": ["./src/interfaces"],
      "@Interfaces/*": ["./src/interfaces/*"],
      "@Libraries": ["./src/libraries"],
      "@Libraries/*": ["./src/libraries/*"],
      "@Plugins": ["./src/plugins"],
      "@Plugins/*": ["./src/plugins/*"],
      "@Providers": ["./src/providers"],
      "@Providers/*": ["./src/providers/*"],
      "@Services": ["./src/services"],
      "@Services/*": ["./src/services/*"],
      "@Stores": ["./src/stores"],
      "@Stores/*": ["./src/stores/*"],
      "@Styles": ["./src/styles"],
      "@Styles/*": ["./src/styles/*"],
      "@Types": ["./src/types"],
      "@Types/*": ["./src/types/*"],

      "@AuthModule": ["./src/modules/Auth"],
      "@AuthModule/*": ["./src/modules/Auth/*"],
      "@DiagnosticModule": ["./src/modules/Diagnostic"],
      "@DiagnosticModule/*": ["./src/modules/Diagnostic/*"],
      "@NotificationModule": ["./src/modules/Notification"],
      "@NotificationModule/*": ["./src/modules/Notification/*"],
      "@FiscalModule": ["./src/modules/Fiscal"],
      "@FiscalModule/*": ["./src/modules/Fiscal/*"],
      "@BriefingModule": ["./src/modules/Briefing"],
      "@BriefingModule/*": ["./src/modules/Briefing/*"],
      "@ContractsModule": ["./src/modules/Contracts"],
      "@ContractsModule/*": ["./src/modules/Contracts/*"],
      "@RadarModule": ["./src/modules/Radar"],
      "@RadarModule/*": ["./src/modules/Radar/*"],
      "@HomeModule": ["./src/modules/Home"],
      "@HomeModule/*": ["./src/modules/Home/*"],
      "@MetricsModule": ["./src/modules/Metrics"],
      "@MetricsModule/*": ["./src/modules/Metrics/*"],
      "@AssistantModule": ["./src/modules/Assistant"],
      "@AssistantModule/*": ["./src/modules/Assistant/*"],
      "@BrandsModule": ["./src/modules/Brands"],
      "@BrandsModule/*": ["./src/modules/Brands/*"],
      "@PlatformModule": ["./src/modules/Platform"],
      "@PlatformModule/*": ["./src/modules/Platform/*"],
      "@ChannelModule": ["./src/modules/Channel"],
      "@ChannelModule/*": ["./src/modules/Channel/*"],
      "@PartnerModule": ["./src/modules/Partner"],
      "@PartnerModule/*": ["./src/modules/Partner/*"],
      "@PortalModule": ["./src/modules/Portal"],
      "@PortalModule/*": ["./src/modules/Portal/*"],
      "@RepricingModule": ["./src/modules/Repricing"],
      "@RepricingModule/*": ["./src/modules/Repricing/*"],
      "@PersonalizationModule": ["./src/modules/Personalization"],
      "@PersonalizationModule/*": ["./src/modules/Personalization/*"],
      "@PipelineModule": ["./src/modules/Pipeline"],
      "@PipelineModule/*": ["./src/modules/Pipeline/*"],
      "@SiteModule": ["./src/modules/Site"],
      "@SiteModule/*": ["./src/modules/Site/*"],
      "@UserModule": ["./src/modules/User"],
      "@UserModule/*": ["./src/modules/User/*"],
    }
  }
}
