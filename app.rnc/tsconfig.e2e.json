{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["e2e/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    // A spec file is Node, but the callback inside `page.evaluate` is not: Playwright serialises it
    // and runs it in the browser, where `document` and `window` are the whole point. Without DOM
    // here, `vue-tsc --build` fails on every such callback and the only way to write one is to pass
    // it as an unchecked string.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}
