# Vercel Edge middleware (staff gate) — set these in the Vercel project, not locally.
# Delete this file (and middleware.ts + middleware/) if the docs are public.

# API_URL must INCLUDE the /api prefix — that is where /auth/me actually lives.
API_URL={{API_HOST}}
APP_LOGIN_URL={{APP_LOGIN_URL}}

# Laravel derives the session cookie from APP_NAME: Str::slug(APP_NAME) . '-session'.
# APP_NAME={{SLUG}}  →  '{{SLUG}}-session'. Override only if the API changes it.
SESSION_COOKIE_NAME={{API_SESSION_COOKIE}}

# Staff gate — the docs are staff-only. The middleware accepts a session whose
# /auth/me payload has this role_slug OR carries this permission.
DOCS_STAFF_ROLE_SLUG={{STAFF_ROLE_SLUG}}
DOCS_STAFF_PERMISSION={{STAFF_PERMISSION}}
# Optional: also accept a role by its NAME. No default — leave unset unless a role
# name has been chosen for this on purpose.
# DOCS_STAFF_ROLE_NAME=
