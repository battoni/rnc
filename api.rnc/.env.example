APP_NAME=api.rnc
APP_ENV=local
# The products this bootstrap serves are Brazilian, so dates are shown and stored in São Paulo
# time. A product elsewhere sets its own zone here; nothing else assumes this one.
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
IDEA_ATTACHMENT_DISK=public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rnc
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# Shared session for the docs portal (docs.rnc). Its Edge middleware calls GET /auth/me with
# this API's session cookie, so the cookie has to reach the portal's host. Config reads all three
# from env — no code change:
#   1) Scope the cookie to the parent domain shared by app and docs:
#        SESSION_DOMAIN=.rnc.test          # prod: .<your-domain>
#   2) Append the docs host to SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS below.
# With SESSION_DOMAIN=null
SESSION_SAME_SITE=lax the cookie is bound to the exact host and the portal gate never sees it.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` writes the whole message to storage/logs and sends nothing — the right default for
# a bootstrap and for local work, and it is what `make fresh` leaves you with.
#
# To actually send, set MAIL_MAILER=resend and fill RESEND_API_KEY below. The transport is
# already configured in config/mail.php; the package is a dependency.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# The address MUST belong to a domain verified in Resend. This is the one that fails quietly:
# with an unverified sender Resend accepts the call and never delivers, and nothing in the
# application reports it — no exception, no failed job, no line in the log. `MailSenderTest`
# refuses the combination rather than letting it ship.
# MAIL_VERIFIED_DOMAINS is the project's own answer to "which domains did Resend verify for
# US". It lives here, next to the address it constrains, because it is project data: a shared
# test cannot know it, and a bootstrap that hard-codes one ships another product's domain to
# every project born from it. Comma-separated; add a second domain here rather than working
# around the check.
MAIL_VERIFIED_DOMAINS="mail.example.com"
MAIL_FROM_ADDRESS="nao-responda@mail.example.com"
# The name a person sees in their inbox, and it is NOT ${APP_NAME}. `api.rnc` is this API's own
# codename — it belongs in logs and queue names, not above a message to a human. Gmail showed
# "api.rnc <nao-responda@…>" on the first send, which reads as machine noise and is one of the
# signals a filter weighs. Use the PRODUCT's name.
MAIL_FROM_NAME="rnc"

# From https://resend.com/api-keys. One key per project: revoking one must not take the others
# down with it. Left empty here on purpose — an example file with a live credential in it is a
# credential in git history.
RESEND_API_KEY=

# Self-service registration (config/registration.php). Closed in this product (rnc-4 R7, D21):
# while REGISTRATION_ENABLED=false the three routes answer 404.
REGISTRATION_ENABLED=false
# REGISTRATION_VERIFY_EMAIL=false creates the account on sign-up instead of mailing a code.
# REGISTRATION_NEW_USER_STATUS=inactive parks new accounts for a human to approve.
REGISTRATION_VERIFY_EMAIL=true
REGISTRATION_CODE_TTL_MINUTES=15
REGISTRATION_NEW_USER_STATUS=active

# Sign-in by a code sent to the phone. `log` delivers nothing and refuses in production — bind a
# real driver in AppServiceProvider::LOGIN_CODE_SENDERS before turning the phone login on.
# LOGIN_CODE_EXPOSE=true returns the code as `dev_code` (never in production). Opt in locally.
LOGIN_CODE_SENDER=log
LOGIN_CODE_EXPOSE=false

# The Reforma assistant's answerer (rnc-3 R16): `curated` (Franco's reviewed notes) is the only
# driver. Any other name stops the app at boot (AppServiceProvider::ASSISTANT_DRIVERS).
ASSISTANT_DRIVER=curated

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The root host and every firm host (rnc-4 D4): the SPA reaches the API through Vite's /api proxy.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,*.localhost:5173
SUPERADMIN_PASSWORD=12345678
# The password of every other seeded account (manager, the permission-less user) and the
# UserFactory default. Seeded in plaintext — the model's `hashed` cast hashes it. Set it on any
# server that seeds: the default is guessable, and a deploy that re-seeds re-creates the accounts.
SEEDER_PWD=password
# Every origin the SPA is served from. http://localhost:5173 is `npm run dev` and the Playwright
# suite — without it that origin gets no CORS headers and the app renders a blank screen.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS_PATTERNS=

# The platform (rnc-4, config/platform.php): a firm lives at <slug>.PLATFORM_ROOT_DOMAIN, the root
# and www serve the platform firm. DEFAULT_FIRM_SLUG is the firm of a request with no X-Firm header —
# the root's, so the platform firm `hub` (D6; phpunit.xml pins `franco` for the suite).
PLATFORM_NAME="Hub da Reforma"
PLATFORM_ROOT_DOMAIN=localhost
DEFAULT_FIRM_SLUG=hub

# The proxies in front of PHP (config/trustedproxy.php, rnc-4 F7): their addresses or CIDR ranges,
# comma-separated, so `$request->ip()` — the view-as audit's address — is the client's, read from
# X-Forwarded-For. Empty locally: `php artisan serve` is reached directly.
TRUSTED_PROXIES=
