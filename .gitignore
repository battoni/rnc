# Personal AI tooling overrides — not for team sharing
CLAUDE.local.md
.claude/settings.local.json

# Claude Code harness runtime files
.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.lock

# GitHub tokens and secrets
github-token
*.token
*.secret
.env
.env.local

# Tokens Studio sync files (if stored locally)
figma-tokens/

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
*.swp
*.swo
*~

# Node modules (if you add any)
node_modules/

# Python tooling (cortex/sync)
__pycache__/
*.pyc

# Cortex sync: per-run loss report (regenerated each sync)
.cortex-loss-report.txt

# Build outputs
dist/
build/

# Planning lives beside the code, not in its history: drafts, decision logs and PR notes change
# faster than the code and are nobody else's to review.
plans/

# One worktree per session: its record (scripts/worktree.py), never versioned.
.worktree.json
